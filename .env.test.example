# Copy to .env.test (git-ignored) to enable the API tests that write data.
# Without it only the read-only anon suite runs (`npm run test:api`).
#
# The tests run against the Supabase project in .env. They create questions
# (official_number >= 900000000), images, subscribers (@example.invalid) and
# draft newsletters, and delete them at the end. Their audit_log rows stay.
# No newsletter is ever sent.

# An account listed in public.admins.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Optional: an Auth account that is NOT in public.admins (create it by hand in
# Supabase Auth, signups are disabled). Enables the non-admin suite.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

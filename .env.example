# Supabase project URL (shared with the "remindeer" landing project — same Supabase backend).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase PUBLISHABLE key (client-side, RLS-bound). Same value/family as
# SUPABASE_PUBLISHABLE_KEY in the landing project's .env — never the secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
